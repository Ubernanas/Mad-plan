{
  "name": "madplan",
  "version": "0.1.0",
  "private": true,
  "description": "Ugentlig madplan og indkøbsliste ud fra tilbud. Kun til eget brug.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "fetch-fixtures": "tsx scripts/fetch-fixtures.ts",
    "fetch-week": "tsx scripts/fetch-week.ts",
    "make-plan": "tsx scripts/make-plan.ts",
    "dev": "tsx watch src/server.ts",
    "start": "node src/server.ts",
    "build-art": "tsx scripts/build-art.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.13",
    "node-cron": "^4.6.0",
    "node-html-parser": "^9.0.5"
  },
  "devDependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
